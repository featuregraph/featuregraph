    "value": 1e-12
   }
  ],
  "preprocessing_steps": [
   "respiration_smooth is the rolling maximum of respiration over smooth_window samples, then the rolling mean over smooth_window samples, shifted back by smooth_window samples so that it is a look-ahead envelope",
