    "name": "smooth_window",
    "value": 100
   },
   {
    "name": "numerical_atol",
    "value": 1e-12
   }
  ],
  "preprocessing_steps": [
   "respiration_smooth is the rolling maximum of respiration over smooth_window samples, then the rolling mean over smooth_window samples, shifted back by smooth_window samples to create a look-ahead envelope",
   "respiration_change is the first difference of respiration_smooth",
   "observations where respiration_smooth or respiration_change is undefined at the edges of a subject's record are excluded from the partition and counted in the validation report"
  ],
  "provenance": [
