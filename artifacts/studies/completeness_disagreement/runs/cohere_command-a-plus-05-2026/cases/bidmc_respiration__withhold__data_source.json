      "parameter": "numerical_atol"
     }
    }
   }
  ],
  "time_semantics": "One row represents an instant; consecutive rows are spaced 8 milliseconds apart.",
  "title": "BIDMC respiratory objects at a fixed envelope scale",
  "validations": [
