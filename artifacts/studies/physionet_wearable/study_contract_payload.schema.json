{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureGraph PhysioNet wearable study payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "study",
    "dataset",
    "sources",
    "participant_cohorts",
    "protocol_versions",
    "exclusions",
    "state_compiler",
    "measurements",
    "joins",
    "analysis",
    "validations",
    "claim_boundaries",
    "unresolved_questions"
  ],
  "properties": {
    "contract_version": {
      "const": "physionet-wearable-study-v1"
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit_of_analysis"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit_of_analysis": {"type": "string", "minLength": 1}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "doi", "source_url", "base_url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_directory_template",
        "tags_file",
        "self_report_file_template",
        "signals",
        "timeline_frequency",
        "interval_closure",
        "unassigned_label"
      ],
      "properties": {
        "subject_directory_template": {"type": "string", "minLength": 1},
        "tags_file": {"type": "string", "minLength": 1},
        "self_report_file_template": {"type": "string", "minLength": 1},
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "file"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "file": {"type": "string", "minLength": 1}
            }
          }
        },
        "timeline_frequency": {"type": "string", "minLength": 1},
        "interval_closure": {"enum": ["left", "right", "both", "neither"]},
        "unassigned_label": {"type": "string", "minLength": 1}
      }
    },
    "participant_cohorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cohort",
          "subject_prefix",
          "first_subject_number",
          "last_subject_number"
        ],
        "properties": {
          "cohort": {"type": "string", "minLength": 1},
          "subject_prefix": {"type": "string", "minLength": 1},
          "first_subject_number": {"type": "integer", "minimum": 0},
          "last_subject_number": {"type": "integer", "minimum": 0}
        }
      }
    },
    "protocol_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurrences", "self_report_columns"],
        "properties": {
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "start_tag_index", "end_tag_index"],
              "properties": {
                "state": {"type": "string", "minLength": 1},
                "start_tag_index": {"type": "integer", "minimum": 0},
                "end_tag_index": {"type": "integer", "minimum": 0}
              }
            }
          },
          "self_report_columns": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "reason"],
        "properties": {
          "subject_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "state_compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "state_column", "group_by", "events"],
      "properties": {
        "version": {"const": "state-contract-v1"},
        "state_column": {"type": "string", "minLength": 1},
        "group_by": {"type": "string", "minLength": 1},
        "events": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["enter_label", "exit_label"]}
            }
          }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampling_policy", "statistics"],
      "properties": {
        "sampling_policy": {"const": "preserve_native_rate"},
        "statistics": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["samples", "mean", "median", "min", "max"]}
        }
      }
    },
    "joins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_reports"],
      "properties": {
        "self_reports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keys", "cardinality"],
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "cardinality": {
              "enum": ["one_to_one", "many_to_one", "one_to_many"]
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_kinds"],
      "properties": {
        "stage_kinds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "validations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_eligible_subjects",
        "expected_declared_occurrences",
        "expected_compiler_checks",
        "require_exact_boundaries",
        "require_positive_durations",
        "require_complete_self_report_join",
        "require_native_signal_coverage",
        "require_cross_protocol_schema"
      ],
      "properties": {
        "expected_eligible_subjects": {"type": "integer", "minimum": 1},
        "expected_declared_occurrences": {"type": "integer", "minimum": 1},
        "expected_compiler_checks": {"type": "integer", "minimum": 1},
        "require_exact_boundaries": {"type": "boolean"},
        "require_positive_durations": {"type": "boolean"},
        "require_complete_self_report_join": {"type": "boolean"},
        "require_native_signal_coverage": {"type": "boolean"},
        "require_cross_protocol_schema": {"type": "boolean"}
      }
    },
    "claim_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
